","speaker1_x":514.0,"speaker1_y":543.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":1199.0,"speaker2_y":544.0,"speaker2_w":458.0,"speaker2_h":567.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":1419.0,"obj1_y":579.0,"obj1_w":380.0,"obj1_h":500.0,"obj2_x":1728.0,"obj2_y":573.0,"obj2_w":390.0,"obj2_h":513.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune"},{"speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sRecolteur1","portrait3_name":"","obj1_name":"sYvan1","obj2_name":"sCatherine1","speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":true,"wait_after_ms":2000.0,"text":"Alors que Valérius s'approcha de Kaelen pour confronter le sournois voleur. Kaelen lui pointa du doigt la bague.","speaker1_x":514.0,"speaker1_y":543.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":1199.0,"speaker2_y":544.0,"speaker2_w":458.0,"speaker2_h":567.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":1419.0,"obj1_y":579.0,"obj1_w":380.0,"obj1_h":500.0,"obj2_x":1728.0,"obj2_y":573.0,"obj2_w":390.0,"obj2_h":513.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune"},{"speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sRecolteur1","portrait3_name":"","obj1_name":"sYvan1","obj2_name":"sCatherine1","speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":true,"wait_after_ms":2000.0,"text":"Valérius : \"Neutralisez le ! Ne le tuez surtout pas! Nous avons besoin de lui vivant!","speaker1_x":514.0,"speaker1_y":543.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":1199.0,"speaker2_y":544.0,"speaker2_w":458.0,"speaker2_h"