ée la fleche. Il aperçu une ombre lointaine, cachée parmi les arbres.","speaker1_x":514.0,"speaker1_y":542.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":1427.0,"speaker2_y":549.0,"speaker2_w":353.0,"speaker2_h":577.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":1419.0,"obj1_y":579.0,"obj1_w":380.0,"obj1_h":500.0,"obj2_x":1219.0,"obj2_y":652.0,"obj2_w":390.0,"obj2_h":513.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune"},{"speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sValerius","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Un hurlement strident rappelant le loup, mais plus guttural et bestial suivi d'un claquement rapide se fit entendre dans la même direction.","speaker1_x":514.0,"speaker1_y":542.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":1427.0,"speaker2_y":549.0,"speaker2_w":353.0,"speaker2_h":577.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":1419.0,"obj1_y":579.0,"obj1_w":380.0,"obj1_h":500.0,"obj2_x":1219.0,"obj2_y":652.0,"obj2_w":390.0,"obj2_h":513.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune"},{"speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sValerius","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Valérius : \" Sale chien ! Ils ont assassiner le Récolteur avant qu'il ne parle ! \"","speaker1_x":514.0,"speaker1_y":542.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x"