,"speaker2_w":300.0,"speaker2_h":451.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":833.0,"obj1_y":576.0,"obj1_w":380.0,"obj1_h":500.0,"obj2_x":1142.0,"obj2_y":621.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1012.0,"textbox_y":966.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"FonduInverse","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelenIncantation","portrait2_name":"sValerius","portrait3_name":"","obj1_name":"sPortailHeros","obj2_name":"","speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":true,"wait_after_ms":2000.0},{"text":"Kaelen : \" Voilà de quoi faire une armée ! ","speaker1_x":483.0,"speaker1_y":600.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1479.0,"speaker2_y":602.0,"speaker2_w":300.0,"speaker2_h":451.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":833.0,"obj1_y":576.0,"obj1_w":380.0,"obj1_h":500.0,"obj2_x":1142.0,"obj2_y":621.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1012.0,"textbox_y":966.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"FonduInverse","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelenIncantation","portrait2_name":"sValerius","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Valérius : \" Impressionant.... Grâce à vous, nous allons pouvoir gagné cette guerre !","speaker1_x":483.0,"speaker1_y":600.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1479.0,"speaker2_y":602.0,"speaker2_w":300.0,"speaker2_h":451.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":833.0,"obj1_y":576.0,"obj1_w":380.0,"obj1_h":500.0,"obj2_x":1142.0,"obj2_y":621.0,"o