26.0,"textbox_x":1010.0,"textbox_y":966.39999999999998,"portrait1_effect":"SlideDroiteInverse","portrait2_effect":"SlideGaucheInverse","portrait3_effect":"SlideGaucheInverse","obj1_effect":"FonduInverse","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelen","portrait2_name":"","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0}],"duel_bot_id":0.0,"id":"scene_3","bg":"sEntreeForteresseSkarl","duel_player_deck":"fureur_sauvage","bg_sound":"SonChap1_3","bg_sound2":"SonChap1_3","speaker1_flip":false},{"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"lines":[{"text":"Kaelen arriva enfin à la capital. Bien que le temps ait changer les choses, il reconnu cette ville situé entre les montagnes.","speaker1_x":489.0,"speaker1_y":600.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1491.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1010.0,"textbox_y":966.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"","portrait2_name":"","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Plusieur jours passèrent durant lesquelle Kaelen vagabonda dans la capital afin de s'informer sur le monde qui avait changé.","speaker1_x":489.0,"speaker1_y":600.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1491.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1010.0,"textbox_y":966.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"","portrait2_name":"","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Un jour, Valérius vînt le chercher pour une audience avec le roi comme il lui avait promis.","speaker1_x":489.0,"speaker1_y":600.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1491.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1010.0,"textbox_y":966.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"","portrait2_name":"","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0}],"duel_bot_id":0.0,"id":"scene_4","bg":"sEntreHautRempart","duel_player_deck":"fureur_sauvage","bg_sound":"SonChap1_1","bg_sound2":"SonChap1_2","speaker1_flip":false},{"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"lines":[{"text":"","speaker1_x":494.0,"speaker1_y":594.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1407.0,"speaker2_y":572.0,"speaker2_w":411.0,"speaker2_h":504.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1008.0,"textbox_y":967.39999999999998,"portrait1_effect":"SlideGauche","portrait2_effect":"Fondu","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sRoiHumain","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Le roi qui attendait Kaelen, se leva à sa vue. \" Kaelen, je présume ? Valérius m'a raconté ce que vous aviez fait pour nous ! Je vous en remercie. Mais il m'a aussi raconté votre histoire et votre magie. M'accorderiez vous un récit? \"","speaker1_x":494.0,"speaker1_y":594.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1373.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1008.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelen","portrait2_name":"sRoiHumain","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Kaelen, surpris par la modestie du roi, se sentit soulager et commença à expliquer l'histoire de son peuple, les brèches et ce qu'il avait vécu depuis.","speaker1_x":494.0,"speaker1_y":594.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1373.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1008.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelen","portrait2_name":"sRoiHumain","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Kaelen : \" Voila mon roi, vous savez tout désormais. Je dois trouver ces failles et les fermer. Ainsi je retrouverai peut etre mes compagnons perdu eux aussi. \"","speaker1_x":494.0,"speaker1_y":594.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1373.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1008.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelen","portrait2_name":"sRoiHumain","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Roi : \" Hé bien, tout ceci est ahurissant ! Mais au vu de vos exploits récents, je ne peux que vous croire. Et croyez moi, je sais comment vous remercier ! \"","speaker1_x":494.0,"speaker1_y":594.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1373.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1008.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelen","portrait2_name":"sRoiHumain","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Roi : \" J'aurai aimer que vous rejoigner ma garde personnelle pour m'aider dans mon royaume mais je comprend que votre mission est plus importante ! Ainsi, je vais demander à mes sujets de vous préparer une carte du monde connu ainsi que des provisions pour votre voyages. \"","speaker1_x":494.0,"speaker1_y":594.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1373.0,"speaker2_y":596.0,"speaker2_w":402.0,"speaker2_h":477.0,"speaker3_x":1041.0,"speaker3_y":585.0,"speaker3_w":238.0,"speaker3_h":332.0,"obj1_x":1061.0,"obj1_y":558.0,"obj1_w":361.0,"obj1_h":345.0,"obj2_x":1178.0,"obj2_y":710.0,"obj2_w":296.0,"obj2_h":526.0,"textbox_x":1008.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGaucheInverse","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":1.0,"portrait1_name":"sKaelen","portrait2_name":"sRoiHumain","portrait3_name":"","obj1_name":"","obj2_name":"","speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":false,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0},{"text":"Roi : \" Va Kaelen, Archonte de HautRempart ! Trouve des amis et sauve le monde ! Si un jour tu as besoin de nous, Humains de Haut rempart, nous t'aideront dans ta quête! \"","speaker1_x":494.0,"speaker1_y":594.0,"speaker1_w":319.0,"speaker1_h":456.0,"speaker2_x":1373.0,"speaker2_y"