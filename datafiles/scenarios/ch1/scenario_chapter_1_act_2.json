ue)","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretreLumiere","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Kaelen : La magie de la lumière, le pouvoir sacré des protecteurs de ce monde...","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":915.0,"speaker2_y":536.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretreLumiere","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"La lumière émanente du prêtre enveloppa Kaelen.","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretreLumiere","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Prêtre : Je sens.... l'Abysse. Les déchirure dimensionnelles sont ancrées dans votre essence, Archonte, comme si elle faisait partie de vous.","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Pulse","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretreTrouble","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Prêtre : Mais sous cette charge abyssalle... je sens aussi une âme pure. Il n'y a ni chaos, ni destruction. Seulement ... Une profonde confusion.","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretre","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Kaelen : J'ai bien peur que votre confusion ne soit la mienne. Pour moi, mon peuple n'est parti que quelques années. Mais.....","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretre","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Kaelen regarde tout autour de lui à la recherche de repère.","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretre","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Kaelen : Je ne vois qu'une histoire oubliée... Des milliers d'années se sont écoulés n'est ce pas?","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":960.0,"speaker3_y":594.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretre","portrait3_name":"","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":1318.0,"speaker3_y":503.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"SlideGauche","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":2.0,"portrait1_name":"sKaelen","portrait2_name":"sPretre","portrait3_name":"sValerius","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Soldat : Les brèches sont apparu il y a envirion 10 000 ans selon les textes les plus anciens. L'histoire s'est perdue au fil du temps. Il n'en reste qu'un receuil de contes sur des guerres et la chute d'une grande ère.","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":1318.0,"speaker3_y":503.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1013.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":3.0,"portrait1_name":"sKaelen","portrait2_name":"sPretre","portrait3_name":"sValerius","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_flip":true,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"Kaelen : Alors cela confirme mon hypothèse. Mon peuple a été oublié... Nous sommes revenus pour combattre et fermer ces failles. D'autre Archontes étaient avec moi mais le tranfert nous a séparés. Ils sont quelque part dans ce monde... perdu, comme moi...","speaker1_x":534.0,"speaker1_y":539.0,"speaker1_w":365.0,"speaker1_h":567.0,"speaker2_x":912.0,"speaker2_y":535.0,"speaker2_w":384.0,"speaker2_h":569.0,"speaker3_x":1318.0,"speaker3_y":503.0,"speaker3_w":420.0,"speaker3_h":640.0,"obj1_x":651.0,"obj1_y":569.0,"obj1_w":482.0,"obj1_h":576.0,"obj2_x":1017.0,"obj2_y":253.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":3.0,"portrait1_name":"sKaelen","portrait2_name":"sPretre","portrait3_name":"sValerius","obj1_name":"","obj2_name":""},{"speaker1_flip":false,"speaker2_f