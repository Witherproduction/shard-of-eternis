_ms":2000.0,"text":"","speaker1_x":519.0,"speaker1_y":572.0,"speaker1_w":324.0,"speaker1_h":431.0,"speaker2_x":1139.0,"speaker2_y":582.0,"speaker2_w":298.0,"speaker2_h":436.0},{"speaker3_x":1316.0,"speaker3_y":238.0,"speaker3_w":323.0,"speaker3_h":438.0,"obj1_x":1482.0,"obj1_y":596.0,"obj1_w":376.0,"obj1_h":424.0,"obj2_x":906.0,"obj2_y":183.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":3.0,"portrait1_name":"vespera","portrait2_name":"pere_vieille_aube","portrait3_name":"mere_vieille_aube","obj1_name":"fils_vieille_aube","obj2_name":"","speaker1_flip":true,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"La famille qui possedaient ces terre autrefois hantaient encore leurs moulins. La famille Vieille-Aube.","speaker1_x":519.0,"speaker1_y":572.0,"speaker1_w":324.0,"speaker1_h":431.0,"speaker2_x":1139.0,"speaker2_y":582.0,"speaker2_w":298.0,"speaker2_h":436.0},{"speaker3_x":1316.0,"speaker3_y":238.0,"speaker3_w":323.0,"speaker3_h":438.0,"obj1_x":1482.0,"obj1_y":596.0,"obj1_w":376.0,"obj1_h":424.0,"obj2_x":906.0,"obj2_y":183.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":3.0,"portrait1_name":"vespera","portrait2_name":"pere_vieille_aube","portrait3_name":"mere_vieille_aube","obj1_name":"fils_vieille_aube","obj2_name":"","speaker1_flip":true,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"\"Père, encore une marionnette des nécromanciens ! \"","speaker1_x":519.0,"speaker1_y":572.0,"speaker1_w":324.0,"speaker1_h":431.0,"speaker2_x":1139.0,"speaker2_y":582.0,"speaker2_w":298.0,"speaker2_h":436.0},{"speaker3_x":1316.0,"speaker3_y":238.0,"speaker3_w":323.0,"speaker3_h":438.0,"obj1_x":1482.0,"obj1_y":596.0,"obj1_w":376.0,"obj1_h":424.0,"obj2_x":906.0,"obj2_y":183.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":3.0,"portrait1_name":"vespera","portrait2_name":"pere_vieille_aube","portrait3_name":"mere_vieille_aube","obj1_name":"fils_vieille_aube","obj2_name":"","speaker1_flip":true,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"\" Mon amour, elle veut piller notre production ! Eliminons la !","speaker1_x":519.0,"speaker1_y":572.0,"speaker1_w":324.0,"speaker1_h":431.0,"speaker2_x":1139.0,"speaker2_y":582.0,"speaker2_w":298.0,"speaker2_h":436.0},{"speaker3_x":1316.0,"speaker3_y":238.0,"speaker3_w":323.0,"speaker3_h":438.0,"obj1_x":1482.0,"obj1_y":596.0,"obj1_w":376.0,"obj1_h":424.0,"obj2_x":906.0,"obj2_y":183.0,"obj2_w":300.0,"obj2_h":300.0,"textbox_x":1012.0,"textbox_y":967.39999999999998,"portrait1_effect":"Aucune","portrait2_effect":"Aucune","portrait3_effect":"Aucune","obj1_effect":"Aucune","obj2_effect":"Aucune","text_effect":"Aucune","speaker":3.0,"portrait1_name":"vespera","portrait2_name":"pere_vieille_aube","portrait3_name":"mere_vieille_aube","obj1_name":"fils_vieille_aube","obj2_name":"","speaker1_flip":true,"speaker2_flip":false,"speaker3_flip":true,"obj1_flip":false,"obj2_flip":false,"wait_after_ms":2000.0,"text":"\" Votre magie ne nous corrompera pas, nécromancienne ! \"","speaker1_x":519.0,"speaker1_y":572.0,"speaker1_w":324.0,"speaker1_h":431.0,"speaker2_x":1139.0,"speaker2_y":582.0,"speaker2_w":298.0,"speaker2_h":436.0},{"speaker3_x":1316.0,"speaker3_y":238.0,"speaker3_w":323.0,"speaker3_h":438.0,"obj1_x":1482.0,"obj1_y":596.0,"obj1_w":376.0,"obj1_h":424.0,"ob