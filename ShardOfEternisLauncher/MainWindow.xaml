<Window x:Class="ShardOfEternisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shard of Eternis Launcher"
        Height="520"
        Width="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Shard of Eternis" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionLabel" Text="Version: inconnue" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="InstallPathBox" MinWidth="300" Margin="0,0,10,0"/>
                    <Button Content="Parcourir…" Width="100" Click="BrowseInstallPath_Click"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MainStatusLabel" Text="Prêt" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PlayButton" Content="JOUER" Width="150" Height="50" Click="PlayButton_Click"/>
                <Button x:Name="UpdateButton" Content="METTRE À JOUR" Width="150" Height="50" Margin="20,0,0,0" Click="UpdateButton_Click"/>
                <Button x:Name="SettingsButton" Content="PARAMÈTRES" Width="150" Height="50" Margin="20,0,0,0" Click="SettingsButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="10">
            <TextBlock x:Name="StatusLabel" Text="" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>